      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core not running"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Core が実行されていません"
          }
        }
      }
    },
    "Core 未运行，无法创建世界。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core is not running; cannot create a world."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Core が実行されていないため、世界を作成できません。"
          }
        }
      }
    },
    "Core 未运行，无法创建角色。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core is not running; cannot create a character."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Core が実行されていないため、キャラクターを作成できません。"
