    "Core 启动失败（%@）。请查看日志。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core failed to start (%@). Check the logs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Core の起動に失敗しました（%@）。ログを確認してください。"
          }
        }
      }
    },
    "Core 启动超时（%lld 秒内未就绪）。请查看日志或尝试重启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core start timed out (not ready within %lld s). Check the logs or try restarting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Core の起動がタイムアウトしました（%lld 秒以内に準備完了せず）。ログを確認するか再起動してください。"
          }
        }
      }
    },
    "Core 异常：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
