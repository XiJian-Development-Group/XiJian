          "stringUnit": {
            "state": "translated",
            "value": "Notifications are used for proactive voice calls; background activity is used for dynamic wallpapers, proactive calls, desktop pets, etc. Declining won't affect core features."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知権限は自発的な通話に使用され、バックグラウンド活動は動的壁紙・自発的な通話・デスクトップペットなどに使用されます。拒否しても基本機能に影響はありません。"
          }
        }
      }
    },
